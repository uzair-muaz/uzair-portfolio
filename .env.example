# Resend — free tier, works on Vercel with no DNS
# 1. Sign up at https://resend.com with uzair.muaz3k@gmail.com
# 2. Create an API key → paste below (server-only, never NEXT_PUBLIC_)
# 3. On Vercel: Project → Settings → Environment Variables → add RESEND_API_KEY
#
# Without DNS we send FROM onboarding@resend.dev TO your Gmail.
# Reply-To is set to the visitor's email so you can reply in one click.
RESEND_API_KEY=re_xxxxxxxx
